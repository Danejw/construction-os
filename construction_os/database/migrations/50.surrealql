-- construction_os/database/migrations/50.surrealql
-- Artifact factual review runs (manual trigger)

DEFINE TABLE IF NOT EXISTS artifact_review_run SCHEMAFULL;

DEFINE FIELD IF NOT EXISTS note_id ON TABLE artifact_review_run TYPE record<note>;
DEFINE FIELD IF NOT EXISTS project_id ON TABLE artifact_review_run TYPE record<project>;
DEFINE FIELD IF NOT EXISTS status ON TABLE artifact_review_run TYPE string;
DEFINE FIELD IF NOT EXISTS command_id ON TABLE artifact_review_run TYPE option<string>;
DEFINE FIELD IF NOT EXISTS findings ON TABLE artifact_review_run FLEXIBLE TYPE option<object>;
DEFINE FIELD IF NOT EXISTS summary ON TABLE artifact_review_run FLEXIBLE TYPE option<object>;
DEFINE FIELD IF NOT EXISTS content_hash ON TABLE artifact_review_run TYPE string;
DEFINE FIELD IF NOT EXISTS error_message ON TABLE artifact_review_run TYPE option<string>;
DEFINE FIELD IF NOT EXISTS started_at ON TABLE artifact_review_run TYPE option<datetime>;
DEFINE FIELD IF NOT EXISTS finished_at ON TABLE artifact_review_run TYPE option<datetime>;

DEFINE FIELD IF NOT EXISTS created ON artifact_review_run DEFAULT time::now() VALUE $before OR time::now();
DEFINE FIELD IF NOT EXISTS updated ON artifact_review_run DEFAULT time::now() VALUE time::now();

DEFINE INDEX IF NOT EXISTS idx_artifact_review_run_note_started
  ON TABLE artifact_review_run COLUMNS note_id, started_at;
